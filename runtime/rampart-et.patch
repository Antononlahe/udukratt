+export function translitChar(text: string, i: number): string {
+  const c = text[i];
+  const low = c.toLowerCase();
+  const prev = i > 0 ? text[i - 1].toLowerCase() : " ";
+  const next = i + 1 < text.length ? text[i + 1].toLowerCase() : " ";
+  let out: string;
+  if (low === "е") out = !LETTER.test(prev) || VOWELS.has(prev) || prev === "ъ" || prev === "ь" ? "je" : "e";
+  else if (low === "ё") out = "жчшщ".includes(prev) ? "o" : "jo";
+  else if (low === "й") out = VOWELS.has(next) ? "j" : "i";
+  else if (low in BASE) out = BASE[low];
+  else return c;
+  return c !== low && out ? out[0].toUpperCase() + out.slice(1) : out;
+}
+
+export function transliterate(text: string): string {
+  let out = "";
+  for (let i = 0; i < text.length; i++) out += translitChar(text, i);
+  return out;
+}
