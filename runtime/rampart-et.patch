+import { describe, expect, it } from "vitest";
+import { detectHeuristics, detectNeverPii, snapToWords } from "../src/heuristics";
+import { premask } from "../src/premask";
+
+describe("never-PII premask", () => {
+  it("masks identifiers but lets real PII win", () => {
+    const t = "id 694baad6-db4c-9492-bf5f-85e231d06d9c build=a3f9c21 <@U0A3F9K2L> v1.8.0 #8852 ip 10.0.0.1 konto ee382200221020145685";
+    const pii = detectHeuristics(t);
+    const never = detectNeverPii(t, pii);
+    expect(never.map((s) => s.label)).toEqual(["UUID", "HASH", "SLACK_ID", "VERSION", "REF"]);
+    expect(premask(t, [...pii, ...never]).masked).toBe("id [UUID] build=[HASH] <@[SLACK_ID]> [VERSION] [REF] ip [IP_ADDRESS] konto [BANK_ACCOUNT]");
+  });
+  it("snaps model spans to whole words", () => {
+    const t = "kella 17 Holm";
+    expect(snapToWords(t, { start: 2, end: 4, label: "STREET_NAME", score: 1, source: "ner", text: "ll" }).text).toBe("kella");
+  });
+});
