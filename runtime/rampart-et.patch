@@ -0,0 +1,15 @@
+import { describe, expect, test } from "vitest";
+import cases from "./fixtures/et-parity.json";
+import { detectHeuristics } from "../src/heuristics";
+import { mergeSpans } from "../src/policy";
+import { premask } from "../src/premask";
+
+describe("Python/TypeScript deterministic parity", () => {
+  for (const c of cases as { text: string; spans: [number, number, string][]; masked: string }[]) {
+    test(c.text, () => {
+      const spans = mergeSpans(detectHeuristics(c.text)).sort((a, b) => a.start - b.start);
+      expect(spans.map((s) => [s.start, s.end, s.label])).toEqual(c.spans);
+      expect(premask(c.text, spans).masked).toBe(c.masked);
+    });
+  }
+});
