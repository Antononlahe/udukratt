+
+export function isValidIsikukood(digits: string): boolean {
+  if (!/^\d{11}$/.test(digits)) return false;
+  const g = digits.charCodeAt(0) - 0x30;
+  if (g < 1 || g > 8) return false;
+  const year = 1800 + 100 * Math.floor((g - 1) / 2) + Number(digits.slice(1, 3));
+  const month = Number(digits.slice(3, 5));
+  const day = Number(digits.slice(5, 7));
+  const d = new Date(Date.UTC(year, month - 1, day));
+  if (d.getUTCFullYear() !== year || d.getUTCMonth() !== month - 1 || d.getUTCDate() !== day) return false;
+  return isikukoodCheckDigit(digits.slice(0, 10)) === digits.charCodeAt(10) - 0x30;
+}
