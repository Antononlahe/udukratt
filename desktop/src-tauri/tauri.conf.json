{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Udukratt",
  "version": "0.2.0",
  "identifier": "ee.udukratt.desktop",
  "build": { "frontendDist": "../dist", "beforeBuildCommand": "node scripts/prepare-ui.mjs" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Udukratt: Estonian PII redactor", "width": 1100, "height": 820, "dragDropEnabled": false }],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "nsis", "dmg", "app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Offline Estonian PII redactor",
    "windows": { "webviewInstallMode": { "type": "embedBootstrapper" } }
  }
}
